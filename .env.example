# ==============================================================================
# Chase Street Properties — Supabase Configuration
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to find your Project URL & Anon Key
# 3. Copy this file to .env.local and fill in the values below:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Service Role Key (used only on secure server-side routes, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
